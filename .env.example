# Configuracion de despliegue a PRODUCCION (plantilla).
# Copia este archivo como `.env` en la RAIZ DEL PROYECTO (junto a wp.ps1) y
# completa los valores reales. NO versiones el .env con credenciales.

# --- Conexion SSH al hosting ---
WP_PROD_HOST=ssh.example.com
WP_PROD_USER=usuario
WP_PROD_PORT=22
WP_PROD_PASS=            # o usa clave (abajo). No versionar.
WP_PROD_KEY_FILE=workspace/remote/ssh.txt
WP_PROD_KEY_PASSPHRASE=

# --- WordPress en el servidor ---
WP_PROD_WP_ROOT=/home/usuario/www/sitio/public_html
WP_PROD_URL=https://ejemplo.com
WP_PROD_WP=wp

# --- Autor y estado por defecto ---
WP_AUTHOR_ID=1
WP_PROD_STATUS=draft
